/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(self), gyroscope=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.emailjs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Vite's /assets/ files carry a content hash in their names, so a browser
# can keep them for a year. Never add Cache-Control to /* above: Netlify
# applies every matching rule, and two Cache-Control values would clash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep the same name when they change, so keep them a day and
# refresh in the background after that.
/projects/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/feranmi-banner.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/feranmi.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/feranmi.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The résumé gets updated, so only an hour.
/Feranmi_Oyetunde_SWE.pdf
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
